// ==UserScript==
// @name         PvP-Solo Achievements_Cleric
// @namespace    http://tampermonkey.net/
// @version      2026-07-09
// @description  PvP-solo achivement complete
// @author       Arvin
// @match        https://demonicscans.org/*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=demonicscans.org
// @grant        none
// ==/UserScript==

// ======================================================
// CONFIGURATION
// ======================================================

// Combat skill mode:
// "powerSlash"   -> Tokens > 9: Power Slash, else Slash
// "judgmentSeal" -> Tokens > 3: Judgment Seal, else Slash
// "rotate"       -> Tokens > 3: Judgment Seal <-> Sanctified Breach
const skillMode = "powerSlash";


// Low token behavior:
// "STOP" -> Stop completely when PvP tokens <= 5
// "WAIT" -> Keep checking and resume automatically
const lowTokenMode = "STOP";


// ======================================================
// STATE
// ======================================================

let state = "INIT";
// INIT            -> initial page detection
// PVP             -> PvP token checking
// COMBAT          -> battle logic
// WAIT_PVP_LOAD   -> waiting after Back navigation
// STOP            -> stopped


// Used only for rotate mode
// Persistent even when Slash is used
let nextRotationSkill = "judgmentSeal";


// Enemy speed button is clicked once per battle
let enemySpeedActivated = false;


// ======================================================
// MAIN LOOP
// ======================================================

setInterval(async () => {

    try {


        // ==================================================
        // INITIAL STATE CHECK
        // ==================================================

        if (state === "INIT") {

            if (window.location.href === "https://demonicscans.org/pvp.php") {

                state = "PVP";

                console.log("State: PvP");

            } else {

                state = "COMBAT";

                console.log("State: Combat");

            }
        }

        // ==================================================
        // WAIT FOR PvP PAGE AFTER BACK
        // ==================================================

        if (state === "WAIT_PVP_LOAD") {


            if (
                window.location.href ===
                "https://demonicscans.org/pvp.php"
            ) {


                const firstSection =
                      document.querySelector(".section-stat-row");


                if (firstSection) {


                    const tokenElement =
                          [...firstSection.querySelectorAll(".info-pill")]
                    .find(el => el.innerText.includes("Tokens"));


                    if (tokenElement) {


                        console.log("PvP page loaded.");

                        state = "PVP";

                    }

                }

            }


            return;

        }


        // ==================================================
        // PvP STATE
        // ==================================================

        if (state === "PVP") {


            const firstSectionStat =
                  document.querySelector(".section-stat-row");


            if (!firstSectionStat) {
                return;
            }


            const tokenElement =
                  [...firstSectionStat.querySelectorAll(".info-pill")]
            .find(el => el.innerText.includes("Tokens"));



            if (!tokenElement) {
                return;
            }



            const pvpTokens = Number(
                tokenElement.querySelector("span")?.textContent.trim()
            );



            console.log("PvP Tokens:", pvpTokens);



            if (pvpTokens > 5) {


                const findMatchBtn =
                      document.querySelector(
                          ".js-matchmake[data-ladder='solo']"
                      );



                if (findMatchBtn) {


                    findMatchBtn.click();

                    console.log("Clicked Find Solo Match");


                    // wait until combat page loads
                    const combatCheck = setInterval(() => {


                        const attackBtn =
                              document.getElementById("attackBtn");



                        if (attackBtn) {


                            clearInterval(combatCheck);


                            state = "COMBAT";

                            enemySpeedActivated = false;

                            console.log("State: Combat");

                        }


                    }, 500);


                }



            } else {


                console.log("PvP Tokens <= 5");


                if (lowTokenMode === "STOP") {

                    state = "STOP";

                    console.log("Automation stopped.");

                }


            }



            return;

        }




        // ==================================================
        // STOP STATE
        // ==================================================

        if (state === "STOP") {

            return;

        }




        // ==================================================
        // COMBAT STATE
        // ==================================================

        if (state === "COMBAT") {



            // ----------------------------------------------
            // Check match result
            // ----------------------------------------------

            const note =
                  document.getElementById("noteText");



            if (note) {


                const result =
                      note.textContent.trim();



                // WIN
                if (result === "Your side won this season match.") {


                    const continueBtn =
                          document.getElementById("continueRewardsBtn");



                    if (continueBtn) {

                        continueBtn.click();

                        console.log("Clicked Continue");


                        setTimeout(() => {


                            const backBtn =
                                  document.querySelector(
                                      ".back-btn[href='pvp.php']"
                                  );


                            if (backBtn) {

                                backBtn.click();

                                console.log("Clicked Back, waiting for PvP page.");

                                state = "WAIT_PVP_LOAD";

                                enemySpeedActivated = false;

                            }


                        }, 500);


                    }


                    return;

                }




                // LOSS
                if (result === "The opposing side won this season match.") {


                    const backBtn =
                          document.querySelector(
                              ".back-btn[href='pvp.php']"
                          );



                    if (backBtn) {


                        backBtn.click();

                        console.log("Clicked Back, waiting for PvP page.");

                        state = "WAIT_PVP_LOAD";

                        enemySpeedActivated = false;


                    }


                    return;

                }

            }





            // ----------------------------------------------
            // Enemy turn speed
            // ----------------------------------------------

            const fastEnemyBtn =
                  document.getElementById("fastEnemyBtn");



            if (
                fastEnemyBtn &&
                !enemySpeedActivated
            ) {


                if (
                    fastEnemyBtn.textContent.trim()
                    === "Enemy Turns 1s"
                ) {


                    fastEnemyBtn.click();

                    console.log("Enabled Enemy Turns 1s");


                }


                enemySpeedActivated = true;

            }






            // ----------------------------------------------
            // Read combat tokens
            // ----------------------------------------------

            const myTokens =
                  Number(
                      document.getElementById("myTokens")
                      ?.textContent.trim() || 0
                  );



            let skillSelector = "";





            // ----------------------------------------------
            // Choose skill
            // ----------------------------------------------

            if (skillMode === "powerSlash") {



                skillSelector =
                    myTokens > 9
                    ? '#skillsGrid .skillCard[data-skill-id="-1"]'
                : '#skillsGrid .skillCard[data-skill-id="0"]';



            }



            else if (skillMode === "judgmentSeal") {



                skillSelector =
                    myTokens > 3
                    ? '#skillsGrid .skillCard[data-skill-id="9"]'
                : '#skillsGrid .skillCard[data-skill-id="0"]';



            }



            else if (skillMode === "rotate") {



                if (myTokens > 3) {


                    if (nextRotationSkill === "judgmentSeal") {


                        skillSelector =
                            '#skillsGrid .skillCard[data-skill-id="9"]';


                    } else {


                        skillSelector =
                            '#skillsGrid .skillCard[data-skill-id="18"]';


                    }



                } else {


                    skillSelector =
                        '#skillsGrid .skillCard[data-skill-id="0"]';


                }


            }




            const requiredSkill =
                  document.querySelector(skillSelector);



            if (!requiredSkill) {

                return;

            }





            // ----------------------------------------------
            // Attack button required before every skill
            // ----------------------------------------------

            const attackBtn =
                  document.getElementById("attackBtn");



            if (attackBtn) {


                attackBtn.click();

                console.log("Clicked Attack / Skills");


            }




            // ----------------------------------------------
            // Wait for skill enable
            // ----------------------------------------------

            if (requiredSkill.disabled) {


                console.log(
                    "Waiting for:",
                    requiredSkill.querySelector(".skillName")
                    ?.textContent
                );


                return;

            }





            requiredSkill.click();



            console.log(
                "Used:",
                requiredSkill.querySelector(".skillName")
                ?.textContent
            );





            // ----------------------------------------------
            // Update rotation state
            // ----------------------------------------------

            if (
                skillMode === "rotate" &&
                myTokens > 3
            ) {


                if (
                    nextRotationSkill === "judgmentSeal"
                ) {


                    nextRotationSkill =
                        "sanctifiedBreach";


                } else {


                    nextRotationSkill =
                        "judgmentSeal";


                }

            }





            // ----------------------------------------------
            // Delay after skill
            // ----------------------------------------------

            const enemyDelay =
                  fastEnemyBtn &&
                  fastEnemyBtn.classList.contains("active")
            ? 2000
            : 4000;



            await new Promise(
                resolve => setTimeout(resolve, enemyDelay)
            );



        }



    } catch (error) {


        console.error(
            "Script error:",
            error
        );


    }


}, 1000);